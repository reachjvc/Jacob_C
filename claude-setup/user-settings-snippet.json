{
  "theme": "custom:grey-bypass",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js",
    "refreshInterval": 2
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node ~/.claude/dot-state.js working" }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "node ~/.claude/dot-state.js working" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node ~/.claude/dot-state.js working" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node ~/.claude/dot-state.js idle" }] }
    ]
  }
}
