        <mxCell id="ile5mphzso-y__7i0mpR-22" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;DELETE /smurfs/4&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;-&amp;gt; 204 No Content&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Opdaterede tabeller:&amp;nbsp; Smølf: række 4 slettet&amp;nbsp; &amp;nbsp; &amp;nbsp;SmølfeMission: 4 | 1 slettet&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="616" x="889" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-23" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;MoveSmurfRequest: husId&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;PATCH /smurfs/4 {husId: 1}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;-&amp;gt; 204 No Content&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Opdaterede tabeller:&amp;nbsp; Smølf: 4 | Gnavsmølf | 1&amp;nbsp; &amp;nbsp; &amp;nbsp;SmølfeMission: uændret&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="616" x="889" y="-280" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-24" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;UpdateSmurfRequest: navn, husId, missionIds&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;PUT /smurfs/4 {navn: &quot;Gnavsmølf&quot;, husId: 2, missionIds: [1]}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;-&amp;gt; 204 No Content&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Opdaterede tabeller:&amp;nbsp; Smølf: 4 | Gnavsmølf | 2&amp;nbsp; &amp;nbsp; &amp;nbsp;SmølfeMission: kun 4 | 1 (4 | 2 slettet)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="616" x="889" y="-400" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-25" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;GET /smurfs&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;-&amp;gt; 200 OK&amp;nbsp; GetSmurfsResponse [{id: 1, navn: &quot;Jacob&quot;}, {id: 2, navn: &quot;Alex&quot;},&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;{id: 3, navn: &quot;C&quot;}, {id: 4, navn: &quot;Gnavsmølf&quot;}]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="616" x="889" y="-515" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-26" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;UNIT TESTS (ét tjek alene, uden database og browser)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;U1&amp;nbsp; CreateSmurfRequest uden navn&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;gt; afvist: &quot;navn mangler&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;U2&amp;nbsp; CreateSmurfRequest med husId: &quot;abc&quot;&amp;nbsp; &amp;nbsp; &amp;nbsp; -&amp;gt; afvist: &quot;husId skal være et tal&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;U3&amp;nbsp; MoveSmurfRequest med kun husId&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;gt; godkendt&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="616" x="50" y="-200" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-27" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;INTEGRATIONSTESTS (server + database)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Før:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 15px;&quot;&gt;Før: tabellerne har rækkerne fra &quot;Eksempel tabeller&quot;. Kør i rækkefølge: I1 laver smølf 4, som I2-I6 bruger&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I1&amp;nbsp; POST /smurfs {navn: &quot;Gnavsmølf&quot;, husId: 1, missionIds: [1, 2]}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 201 {id: 4}. Smølf: 4 | Gnavsmølf | 1. SmølfeMission: 4 | 1 og 4 | 2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I2&amp;nbsp; GET /smurfs/4&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 200 {navn: &quot;Gnavsmølf&quot;, husNavn: &quot;Svampehuset&quot;, missions: [&quot;Bøllebank til Jacob&quot;, &quot;Rygestop&quot;]}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I3&amp;nbsp; GET /smurfs&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 200, 4 smølfer, hver med kun id og navn&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I4&amp;nbsp; PUT /smurfs/4 {navn: &quot;Gnavsmølf&quot;, husId: 2, missionIds: [1]}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 204. Smølf 4 har husId 2. SmølfeMission har kun 4 | 1&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I5&amp;nbsp; PATCH /smurfs/4 {husId: 1}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 204. Kun husId er ændret&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I6&amp;nbsp; DELETE /smurfs/4&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 204. Række 4 og 4 | 1 er væk. GET /smurfs/4 giver nu 404&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I7&amp;nbsp; POST /smurfs {navn: &quot;Test&quot;, husId: 99, missionIds: []}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 400. Intet gemt, fordi hus 99 ikke findes (fremmednøglen siger nej)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I8&amp;nbsp; GET /smurfs/99&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;gt; 404&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="470" width="616" x="48" y="-110" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-28" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;E2E TESTS (som en rigtig bruger, i browseren)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;E1&amp;nbsp; Opret og se: tryk &quot;Ny smølf&quot; -&amp;gt; skriv Gnavsmølf, vælg Svampehuset,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; vælg Bøllebank til Jacob og Rygestop -&amp;gt; tryk Gem&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; =&amp;gt; Gnavsmølf står i listen. Tryk på den =&amp;gt; siden viser Svampehuset og begge missioner&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;E2&amp;nbsp; Flyt hus: åbn Gnavsmølf -&amp;gt; vælg Rygehuset -&amp;gt; tryk Gem&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; =&amp;gt; siden viser Rygehuset&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;E3&amp;nbsp; Slet: åbn Gnavsmølf -&amp;gt; tryk Slet&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; =&amp;gt; Gnavsmølf er væk fra listen&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="616" x="52" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-29" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;h1&gt;&lt;span style=&quot;font-size: 27px;&quot;&gt;Tests&lt;/span&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="30" width="280" x="48" y="-245" as="geometry" />
        </mxCell>
        <mxCell id="ile5mphzso-y__7i0mpR-30" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Man&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 15px;&quot;&gt;&amp;nbsp;skal kunne oprette, se, rette og slette smølfer, vælge hvilket hus de bor i, og melde dem til missioner.&lt;/span&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="616" x="620" y="-1150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
