        <mxCell id="TUY6XDB20jGGNL42J6Xc-140" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;blockquote style=&quot;background: none 0% 0% / auto repeat scroll padding-box border-box rgb(36, 37, 38); border-color: rgb(42, 43, 44); unicode-bidi: plaintext; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; unicode-bidi: plaintext;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Brugeren skal kunne oprette, se, rette og slette sine mål.&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="80" width="440" x="1532.5" y="395" as="geometry" />
        </mxCell>
        <mxCell id="TUY6XDB20jGGNL42J6Xc-141" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;TESTS&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="230" x="521" y="926.5" as="geometry" />
        </mxCell>
        <mxCell id="TUY6XDB20jGGNL42J6Xc-142" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;U1&amp;nbsp; CreateGoalDTO uden navn&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;-&amp;gt; afvist: &quot;navn mangler&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;U2&amp;nbsp; CreateGoalDTO med targetDate &quot;hej&quot;&amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;gt; afvist: &quot;targetDate er ikke en dato&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;U3&amp;nbsp; PatchGoalDTO med kun targetDate&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; -&amp;gt; godkendt (de andre felter må mangle)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="616" x="328" y="956.5" as="geometry" />
        </mxCell>
        <mxCell id="TUY6XDB20jGGNL42J6Xc-145" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 15px;&quot;&gt;Givet: brugeren er logget ind, og databasen har mål 1-4 og område 1-4 som i dine FK-eksempler.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="616" x="320" y="1146.5" as="geometry" />
        </mxCell>
        <mxCell id="TUY6XDB20jGGNL42J6Xc-146" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;INTEGRATIONSTESTS (server + database)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Før hver test: brugeren er logget ind, mål 1-4 og område 1-4 findes.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I1&amp;nbsp; Send eksempel 1 (POST)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;gt; forvent 201 og tabellerne fra eksempel 1&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I2&amp;nbsp; Send eksempel 3 (GET liste)&amp;nbsp; &amp;nbsp; -&amp;gt; forvent 200 og listen fra eksempel 3&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I3&amp;nbsp; Send eksempel 2 (GET ét mål)&amp;nbsp; &amp;nbsp;-&amp;gt; forvent 200 og svaret fra eksempel 2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I4&amp;nbsp; Send eksempel 4 (PUT)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -&amp;gt; forvent 204 og tabellerne fra eksempel 4&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I5&amp;nbsp; Send eksempel 5 (PATCH)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -&amp;gt; forvent 204 og tabellen fra eksempel 5&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I6&amp;nbsp; Send eksempel 6 (DELETE)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;gt; forvent 204 og tabellerne fra eksempel 6&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I7&amp;nbsp; Send eksempel 7 (uden login)&amp;nbsp; &amp;nbsp;-&amp;gt; forvent 401, intet ændret&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;I8&amp;nbsp; Send POST med areaIds: [99]&amp;nbsp; &amp;nbsp; -&amp;gt; forvent 400, intet gemt&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="616" x="328" y="1196.5" as="geometry" />
        </mxCell>
        <mxCell id="TUY6XDB20jGGNL42J6Xc-147" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;E1&amp;nbsp; Opret og se: log ind -&amp;gt; tryk &quot;Nyt mål&quot; -&amp;gt; skriv &quot;Træn 3 gange om ugen&quot;,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; vælg Helbred og Glæde -&amp;gt; tryk Gem&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; =&amp;gt; målet står i listen. Tryk på det =&amp;gt; siden viser Helbred og Glæde&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;E2&amp;nbsp; Slet: åbn målet -&amp;gt; tryk Slet&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; =&amp;gt; målet er væk fra listen&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;E3&amp;nbsp; Uden konto: åbn mål-siden uden at være logget ind&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; =&amp;gt; du bliver sendt til login-siden&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="616" x="320" y="1476.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
