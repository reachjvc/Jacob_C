@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Jacob_C.Frontend.Features.Examples.Create
@using Jacob_C.Frontend.Features.Examples.Read
@using Jacob_C.Frontend.Features.Examples.Update

<PageTitle>Examples</PageTitle>

<main class="min-h-screen bg-slate-50 px-4 py-12 text-slate-900 sm:px-6">
    <div class="mx-auto grid max-w-3xl gap-6">
        <header>
            <p class="text-sm font-semibold uppercase tracking-widest text-emerald-700">Learning project</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Examples</h1>
            <p class="mt-2 text-slate-600">Each operation lives in its own feature slice.</p>
        </header>

        <CreateExampleForm OnCreated="ReloadExamplesAsync" />

        @if (SelectedExample is not null)
        {
            <UpdateExampleForm @key="SelectedExample.Id"
                               Example="SelectedExample"
                               OnUpdated="FinishUpdateAsync"
                               OnCanceled="CancelUpdate" />
        }

        <ReadExamplesList @ref="ExamplesList" OnEdit="StartUpdate" />
    </div>
</main>

@code {
    private ReadExamplesList? ExamplesList { get; set; }
    private ExampleResponse? SelectedExample { get; set; }

    private void StartUpdate(ExampleResponse example) => SelectedExample = example;

    private void CancelUpdate() => SelectedExample = null;

    private async Task FinishUpdateAsync()
    {
        SelectedExample = null;
        await ReloadExamplesAsync();
    }

    private Task ReloadExamplesAsync() => ExamplesList?.ReloadAsync() ?? Task.CompletedTask;
}
