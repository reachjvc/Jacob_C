@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject HttpClient Http

<PageTitle>Examples</PageTitle>

<main class="min-h-screen bg-slate-50 px-4 py-12 text-slate-900 sm:px-6">
    <div class="mx-auto grid max-w-3xl gap-6">
        <header>
            <p class="text-sm font-semibold uppercase tracking-widest text-emerald-700">Learning project</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Examples</h1>
            <p class="mt-2 text-slate-600">A small CRUD slice using Blazor, a minimal API, and PostgreSQL.</p>
        </header>

        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="form-heading">
            <h2 id="form-heading" class="text-lg font-semibold">@(EditingId is null ? "Add example" : "Edit example")</h2>

            <form class="mt-4 grid gap-4 sm:grid-cols-2" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="grid gap-1.5 text-sm font-medium">
                    Name
                    <input class="rounded-md border border-slate-300 px-3 py-2 font-normal outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100" @bind="Name" required />
                </label>
                <label class="grid gap-1.5 text-sm font-medium">
                    Email
                    <input class="rounded-md border border-slate-300 px-3 py-2 font-normal outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100" type="email" @bind="Email" required />
                </label>

                <div class="flex gap-2 sm:col-span-2">
                    <button class="rounded-md bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900 disabled:opacity-50" type="submit" disabled="@IsBusy">
                        @(EditingId is null ? "Add example" : "Save changes")
                    </button>
                    @if (EditingId is not null)
                    {
                        <button class="rounded-md bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-200 disabled:opacity-50" type="button" @onclick="CancelEdit" disabled="@IsBusy">Cancel</button>
                    }
                </div>
            </form>
        </section>

        @if (ErrorMessage is not null)
        {
            <p class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">@ErrorMessage</p>
        }

        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="examples-heading">
            <h2 id="examples-heading" class="text-lg font-semibold">Saved examples</h2>

            @if (IsLoading)
            {
                <p class="mt-4 text-sm text-slate-600">Loading examples…</p>
            }
            else if (Examples.Count == 0)
            {
                <p class="mt-4 text-sm text-slate-600">No examples yet.</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-slate-200">
                    @foreach (var example in Examples)
                    {
                        <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
                            <div class="min-w-0">
                                <p class="font-medium">@example.Name</p>
                                <p class="break-words text-sm text-slate-600">@example.Email</p>
                            </div>
                            <div class="flex gap-2">
                                <button class="rounded-md bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-800 hover:bg-slate-200 disabled:opacity-50" type="button" @onclick="() => Edit(example)" disabled="@IsBusy">Edit</button>
                                <button class="rounded-md bg-red-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-800 disabled:opacity-50" type="button" @onclick="() => DeleteAsync(example)" disabled="@IsBusy">Delete</button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</main>

@code {
    private List<ExampleResponse> Examples { get; set; } = [];
    private string Name { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private Guid? EditingId { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsBusy { get; set; }
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Examples = await Http.GetFromJsonAsync<List<ExampleResponse>>("api/examples") ?? [];
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Could not reach the API. Check that the web app and PostgreSQL are running.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        ErrorMessage = null;

        try
        {
            var request = new ExampleRequest(Name, Email);
            using var response = EditingId is Guid id
                ? await Http.PutAsJsonAsync($"api/examples/{id}", request)
                : await Http.PostAsJsonAsync("api/examples", request);

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = response.StatusCode == System.Net.HttpStatusCode.BadRequest
                    ? "Enter a name and a valid email address."
                    : $"The API returned status code {(int)response.StatusCode}.";
                return;
            }

            var savedExample = await response.Content.ReadFromJsonAsync<ExampleResponse>();
            if (savedExample is not null)
            {
                Examples.RemoveAll(example => example.Id == savedExample.Id);
                Examples.Add(savedExample);
                Examples = Examples.OrderBy(example => example.Name).ToList();
            }

            CancelEdit();
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Could not save the example.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteAsync(ExampleResponse example)
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        ErrorMessage = null;

        try
        {
            using var response = await Http.DeleteAsync($"api/examples/{example.Id}");
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = $"The API returned status code {(int)response.StatusCode}.";
                return;
            }

            Examples.Remove(example);
            if (EditingId == example.Id)
            {
                CancelEdit();
            }
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Could not delete the example.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void Edit(ExampleResponse example)
    {
        EditingId = example.Id;
        Name = example.Name;
        Email = example.Email;
        ErrorMessage = null;
    }

    private void CancelEdit()
    {
        EditingId = null;
        Name = string.Empty;
        Email = string.Empty;
    }
}
