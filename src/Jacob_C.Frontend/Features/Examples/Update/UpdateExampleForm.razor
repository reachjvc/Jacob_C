@inject HttpClient Http

<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="update-heading">
    <h2 id="update-heading" class="text-lg font-semibold">Update</h2>

    <form class="mt-4 grid gap-4 sm:grid-cols-2" @onsubmit="UpdateAsync" @onsubmit:preventDefault>
        <label class="grid gap-1.5 text-sm font-medium">
            Name
            <input class="rounded-md border border-slate-300 px-3 py-2 font-normal outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100" @bind="Name" required />
        </label>
        <label class="grid gap-1.5 text-sm font-medium">
            Email
            <input class="rounded-md border border-slate-300 px-3 py-2 font-normal outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100" type="email" @bind="Email" required />
        </label>
        <div class="flex gap-2 sm:col-span-2">
            <button class="rounded-md bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900 disabled:opacity-50" type="submit" disabled="@IsBusy">Save changes</button>
            <button class="rounded-md bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-200 disabled:opacity-50" type="button" @onclick="CancelAsync" disabled="@IsBusy">Cancel</button>
        </div>
    </form>

    @if (ErrorMessage is not null)
    {
        <p class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">@ErrorMessage</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public ExampleResponse Example { get; set; } = default!;
    [Parameter] public EventCallback OnUpdated { get; set; }
    [Parameter] public EventCallback OnCanceled { get; set; }

    private string Name { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsBusy { get; set; }

    protected override void OnInitialized()
    {
        Name = Example.Name;
        Email = Example.Email;
    }

    private async Task UpdateAsync()
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        ErrorMessage = null;

        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/examples/{Example.Id}",
                new ExampleRequest(Name, Email));

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = response.StatusCode == System.Net.HttpStatusCode.BadRequest
                    ? "Enter a name and a valid email address."
                    : $"The API returned status code {(int)response.StatusCode}.";
                return;
            }

            await OnUpdated.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Could not update the example.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Task CancelAsync() => OnCanceled.InvokeAsync();
}
