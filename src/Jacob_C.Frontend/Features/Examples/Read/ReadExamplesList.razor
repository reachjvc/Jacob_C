@using Jacob_C.Frontend.Features.Examples.Delete
@inject HttpClient Http

<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="read-heading">
    <h2 id="read-heading" class="text-lg font-semibold">Read</h2>

    @if (IsLoading)
    {
        <p class="mt-4 text-sm text-slate-600">Loading examples…</p>
    }
    else if (Examples.Count == 0)
    {
        <p class="mt-4 text-sm text-slate-600">No examples yet.</p>
    }
    else
    {
        <ul class="mt-3 divide-y divide-slate-200">
            @foreach (var example in Examples)
            {
                <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="min-w-0">
                        <p class="font-medium">@example.Name</p>
                        <p class="break-words text-sm text-slate-600">@example.Email</p>
                    </div>
                    <div class="flex gap-2">
                        <button class="rounded-md bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-800 hover:bg-slate-200" type="button" @onclick="() => OnEdit.InvokeAsync(example)">Edit</button>
                        <DeleteExampleButton Example="example" OnDeleted="ReloadAsync" />
                    </div>
                </li>
            }
        </ul>
    }

    @if (ErrorMessage is not null)
    {
        <p class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">@ErrorMessage</p>
    }
</section>

@code {
    [Parameter] public EventCallback<ExampleResponse> OnEdit { get; set; }

    private List<ExampleResponse> Examples { get; set; } = [];
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;

    protected override Task OnInitializedAsync() => ReloadAsync();

    public async Task ReloadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Examples = await Http.GetFromJsonAsync<List<ExampleResponse>>("api/examples") ?? [];
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Could not read examples from the API.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
