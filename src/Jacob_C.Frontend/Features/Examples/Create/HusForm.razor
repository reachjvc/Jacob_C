@using Jacob_C.Shared.Features.Hus.Create
@inject HttpClient Http

<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="create-heading">
    <h2 id="create-heading" class="text-lg font-semibold">Create</h2>

    <form class="mt-4 grid gap-4 sm:grid-cols-2" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <label class="grid gap-1.5 text-sm font-medium">
            Name
            <input class="rounded-md border border-slate-300 px-3 py-2 font-normal outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100" @bind="Name" required />
        </label>
        <label class="grid gap-1.5 text-sm font-medium">
            Email
            <input class="rounded-md border border-slate-300 px-3 py-2 font-normal outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100" type="email" @bind="Email" required />
        </label>
        <button class="justify-self-start rounded-md bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900 disabled:opacity-50 sm:col-span-2" type="submit" disabled="@IsBusy">
            Create example
        </button>
    </form>

    @if (ErrorMessage is not null)
    {
        <p class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">@ErrorMessage</p>
    }
</section>

@code {
    [Parameter] public EventCallback OnCreated { get; set; }

    private string Name { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsBusy { get; set; }

    private async Task CreateAsync()
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        ErrorMessage = null;

        try
        {
            using var response = await Http.PostAsJsonAsync("api/examples", new CreateHusRequest(Name, 2.4, 1 ));
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = response.StatusCode == System.Net.HttpStatusCode.BadRequest
                    ? "Enter a name and a valid email address."
                    : $"The API returned status code {(int)response.StatusCode}.";
                return;
            }

            Name = string.Empty;
            Email = string.Empty;
            await OnCreated.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "Could not create the example.";
        }
        finally
        {
            IsBusy = false;
        }
    }
}
